# Для локальной выгрузки облачного Bitrix24
BITRIX_WEBHOOK_URL=https://cloud.example.kz/rest/1/REPLACE_WITH_SECRET/

# Для локальной работы с коробочным Bitrix24
TARGET_BITRIX_WEBHOOK_URL=https://box.example.kz/rest/1/REPLACE_WITH_SECRET/

# Настройки выгрузки облака
EXPORT_ACTIVITIES=true
EXPORT_RELATIONS=true
EXPORT_PRODUCT_ROWS=true
EXPORT_TIMELINE_COMMENTS=true
EXPORT_SMART_PROCESSES=true
EXPORT_TASK_STAGES=true
SAVE_RAW_API=false
REQUEST_DELAY_SECONDS=0.03
HTTP_TIMEOUT_SECONDS=60
MAX_RETRIES=6
MAX_PAGES=20000
PROGRESS_EVERY_PAGES=5
OUTPUT_DIR=output
