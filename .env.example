# Полный URL входящего webhook администратора.
# Настоящий токен сюда не вставляйте и не коммитьте.
BITRIX_WEBHOOK_URL=https://yourportal.bitrix24.kz/rest/1/REPLACE_WITH_SECRET/

# Основные разделы выгрузки
EXPORT_ACTIVITIES=true
EXPORT_RELATIONS=true
EXPORT_PRODUCT_ROWS=true
EXPORT_TIMELINE_COMMENTS=true
EXPORT_SMART_PROCESSES=true
EXPORT_TASK_STAGES=true

# Сырые ответы дублируют данные и замедляют запись на диск.
# Для обычной миграционной инвентаризации достаточно json/datasets.
SAVE_RAW_API=false

# Технические настройки
REQUEST_DELAY_SECONDS=0.03
HTTP_TIMEOUT_SECONDS=60
MAX_RETRIES=6
MAX_PAGES=20000
PROGRESS_EVERY_PAGES=5
OUTPUT_DIR=output
